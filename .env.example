# Exact deployed origin, without trailing slash. Never prefix server secrets with VITE_.
APP_ORIGIN=https://your-project.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Register APP_ORIGIN/api?route=auth/callback as the Discord redirect URI.
# Generate a 32-byte base64 key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SAVE_KEYS={"v1":"REPLACE_WITH_BASE64_KEY"}
SAVE_CURRENT_KEY=v1
# Keep old SAVE_KEYS entries when rotating keys so exported saves remain readable.
